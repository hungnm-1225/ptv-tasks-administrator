# Public project URL used to derive the Supabase Auth issuer.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required for safe server-side verification of legacy HS256 Supabase access
# tokens. Obtain this from Supabase Dashboard > Project Settings > API > JWT
# Settings. Never expose it to the frontend or commit it.
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Optional overrides for projects using asymmetric signing keys.
# JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# JWT_ISSUER=https://your-project.supabase.co/auth/v1
# JWT_AUDIENCE=authenticated
# JWT_ALGORITHMS=["HS256"]
