                "first_name",
                "last_name",
                "dob",
                "email"
            ],
            "min_evidence_quotes": 1,
            "risk_level": "medium_mutation",
            "requires_manual_confirmation": false,
            "capability_pipeline": [
                {
                    "capability_id": "workspace.update_user_profile",
                    "name": "Cập nhật hồ sơ người dùng trên Workspace",
                    "inputs_mapping": {
                        "school_name": "resolved_school.name",
                        "school_id": "resolved_school.id",
                        "partner_id": "resolved_school.metadata.parent_id",
                        "user_identifiers": "context.user_emails"
                    },
                    "depends_on": []
                }
            ]
        },
