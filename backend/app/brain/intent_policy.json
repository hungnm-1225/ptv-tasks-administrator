        "update_user_profile": {
            "name": "Cập nhật thông tin & Đổi trường học người dùng",
            "description": "Dò tìm user qua getDataUser.php và cập nhật trường học, đối tác, họ tên, ngày sinh qua updateUser.php",
            "required_entities": [
                "user_identifiers"
            ],
            "required_inputs": [
