      "risk_level": "high_mutation",
      "available": true
    },
    {
      "id": "workspace.school_enroll_users",
      "name": "School Workspace Enroll & Group",
      "description": "School Workspace: Phân nhóm lớp và ghi danh người dùng trực tiếp trên giao diện School Workspace",
      "domain": "School Workspace",
