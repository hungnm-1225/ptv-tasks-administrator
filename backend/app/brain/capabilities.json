{
  "version": "1.0.0",
  "description": "Pythaverse Central Admin & Automation Hub - Master Capability Registry",
  "capabilities": [
    {
      "id": "workspace.resolve_school",
      "name": "Resolve School & Lineage",
      "description": "Phân giải thông tin trường học, kiểm tra phả hệ 3 cấp (Distributor -> Partner -> School) và thông tin đăng nhập trong Két Sắt Vault",
      "domain": "School Workspace",
      "bot_type": "workspace_rpa",
      "action": "resolve_lineage",
      "required_inputs": ["school_name"],
      "optional_inputs": ["country", "school_code"],
      "produces": ["school_id", "school_code", "school_name", "partner_code", "partner_name", "distributor_code", "distributor_name", "credentials_ready"],
      "consumes": [],
      "execution_type": "sync_internal",
      "risk_level": "read_only",
      "available": true
    },
    {
      "id": "cof.parse_file",
      "name": "Parse COF Excel File",
      "description": "Bóc tách file COF (Curriculum Order Form) 3 Tabs: lấy thông tin trường, danh sách môn học, học sinh, giáo viên chưa có tài khoản",
      "domain": "COF Processing",
      "bot_type": "workspace_rpa",
      "action": "parse_cof",
      "required_inputs": ["file_url"],
      "optional_inputs": ["filename"],
      "produces": ["school_name", "country", "courses", "students_to_create", "teachers_to_create", "existing_accounts_count"],
      "consumes": [],
      "execution_type": "sync_internal",
      "risk_level": "read_only",
      "available": true
    },
    {
      "id": "cof.generate_accounts_file",
      "name": "Generate Normalized Accounts File",
      "description": "Tạo file Excel tài khoản chuẩn hóa từ dữ liệu COF hoặc danh sách người dùng để nộp batch",
      "domain": "COF Processing",
      "bot_type": "workspace_rpa",
      "action": "generate_accounts_file",
      "required_inputs": ["users_list"],
      "optional_inputs": ["school_name"],
      "produces": ["account_file_path", "account_file_url", "total_count"],
      "consumes": ["cof.parse_file.students_to_create", "cof.parse_file.teachers_to_create"],
      "execution_type": "sync_internal",
      "risk_level": "read_only",
      "available": true
    },
    {
      "id": "workspace.bulk_account_creation",
      "name": "Bulk Account Creation",
      "description": "Nộp file danh sách tài khoản lên School Workspace qua Playwright RPA, tự động kích hoạt Fast-Path hoặc polling",
      "domain": "School Workspace",
      "bot_type": "workspace_rpa",
      "action": "bulk_account_creation",
      "required_inputs": ["school_identifier", "upload_file_path"],
      "optional_inputs": ["total_count", "attachment_url"],
      "produces": ["account_batch_request_id", "result_file_url", "created_accounts", "execution_status"],
      "consumes": ["cof.generate_accounts_file.account_file_path", "workspace.resolve_school.school_id"],
      "execution_type": "async_polling",
      "risk_level": "high_mutation",
      "available": true
    },
    {
      "id": "workspace.poll_account_batch",
      "name": "Poll Account Batch & Export",
      "description": "Kiểm tra tiến độ Request ID trên School Workspace và tải file kết quả tài khoản đã tạo",
      "domain": "School Workspace",
      "bot_type": "workspace_rpa",
      "action": "check_account_batch",
      "required_inputs": ["school_identifier", "request_id"],
      "optional_inputs": [],
      "produces": ["result_file_url", "created_accounts", "success_count", "failed_count"],
      "consumes": ["workspace.bulk_account_creation.account_batch_request_id"],
      "execution_type": "async_polling",
      "risk_level": "read_only",
      "available": true
    },
    {
      "id": "cof.write_results_back",
      "name": "Write Credentials Back to COF",
      "description": "Ghi ngược Username, Password và Group LMS vào file COF gốc, highlight màu cam nhạt và tải lên Google Drive",
      "domain": "COF Processing",
      "bot_type": "workspace_rpa",
      "action": "write_results_back",
      "required_inputs": ["original_cof_path", "result_file_path"],
      "optional_inputs": ["school_name", "drive_folder_id"],
      "produces": ["final_cof_url", "google_drive_link"],
      "consumes": ["workspace.poll_account_batch.result_file_url"],
      "execution_type": "sync_internal",
      "risk_level": "low_mutation",
      "available": true
    },
    {
      "id": "workspace.school_create_order",
